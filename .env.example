# Copy to .env.local / configure as project secrets. Never commit real values.

# --- Supabase (Lovable Cloud) ---
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_PROJECT_ID=""
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""   # server-only, never exposed to the browser

# --- Paddle client-side token (browser) ---
# .env.development holds the sandbox token (test_...),
# .env.production holds the live token (live_...). The app derives its
# environment from this prefix — do not hard-code an environment anywhere.
VITE_PAYMENTS_CLIENT_TOKEN="live_xxxxxxxxxxxxxxxxxxxxxxxxx"

# --- Paddle server-side API keys (server-only) ---
PADDLE_SANDBOX_API_KEY=""
PADDLE_LIVE_API_KEY=""

# --- Paddle webhook signing secrets (server-only) ---
# Read back once from the notification destination when it is created.
PAYMENTS_SANDBOX_WEBHOOK_SECRET=""
PAYMENTS_LIVE_WEBHOOK_SECRET=""

# --- Lovable platform ---
LOVABLE_API_KEY=""
CHECKOUT_TOKEN_SECRET=""
